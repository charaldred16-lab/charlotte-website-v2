    "quality": "npm run lint && npm run typecheck && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.3"
  }
}
